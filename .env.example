DEBUG=1
SECRET_KEY=change-me-in-local-development
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Europe/Moscow

# Redis используется Celery как брокер фоновых задач.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Путь к папке, где лежат твои текущие ML-модули:
# text_processing/, image_processing/, multimodal_summary.py, utils.py, transcribe_worker.py
PIPELINE_ROOT=D:/path/to/current/project

# Путь к модели определения ключевых точек/ROI, если используется fallback-модель.
KEYPOINTS_MODEL_PATH=D:/Disk C/data/media/slide_dataset/output/best.weights.h5

# Модель LLM-конспекта: qwen или mistral.
DEFAULT_LLM_MODEL=qwen

# По умолчанию письма печатаются в консоль Django.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=lecture-notes@localhost

# Для настоящей почты раскомментируй и настрой SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# PDF становится основным итоговым представлением конспекта.
# Для генерации используется WeasyPrint.
